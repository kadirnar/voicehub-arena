 IGNORE_INDEX = -100
 
 
+def _sample_repetition_aware(logits: Tensor, history: list[int], *,
+                             top_k: int, top_p: float,
+                             generator: torch.Generator | None = None) -> int:
+    """Released CosyVoice RAS: full-distribution nucleus, then repeat rejection."""
+    probabilities, indices = logits.softmax(dim=0).sort(descending=True, stable=True)
+    probabilities, indices = probabilities[:top_k], indices[:top_k]
+    keep = probabilities.cumsum(dim=0) - probabilities < top_p
+    probabilities, indices = probabilities[keep], indices[keep]
+    candidate = int(indices[torch.multinomial(probabilities, 1, replacement=True,
+                                             generator=generator)].item())
+    # Official win_size=10, tau_r=0.1: reject a token already in that window.
+    if candidate in history[-10:]:
+        scores = logits.clone()
+        scores[candidate] = -torch.inf
+        candidate = int(torch.multinomial(scores.softmax(dim=0), 1,
+                                          replacement=True, generator=generator).item())
+    return candidate
+
