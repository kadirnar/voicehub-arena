index 0000000..2ad3e4f
--- /dev/null
+++ b/tests/test_mosstts_v15_inventory.py
@@ -0,0 +1,52 @@
+"""Keep the native graph consistent with the inspected immutable v1.5 release."""
+import dataclasses
+import hashlib
+import json
+from pathlib import Path
+
+import pytest
+import torch
+
+from voicehub.architectures.mosstts.checkpoint import (
+    MossCheckpointReport,
+    _official_facts,
+    _validate_official_report,
+)
+from voicehub.architectures.mosstts.configuration import MossTTSConfig
+from voicehub.architectures.mosstts.metadata import MOSS_TTS_CHECKPOINTS
+from voicehub.architectures.mosstts.modeling import build_mosstts_model
+from voicehub.checkpointing.errors import CheckpointIntegrityError
+
+FIXTURE = json.loads((Path(__file__).parent / 'fixtures/mosstts_delay_v15_inventory.json').read_text())
+
+
+def test_v15_meta_graph_matches_real_release_inventory():
+    with torch.device('meta'):
+        model = build_mosstts_model(MossTTSConfig.from_dict(FIXTURE['config']),
+                                   initialize=False, dtype=torch.bfloat16)
+    state = model.state_dict()
+    assert len(state) == FIXTURE['tensor_count']
+    assert sum(t.numel() for t in state.values()) == FIXTURE['parameter_count']
+    assert sum(t.numel() * t.element_size() for t in state.values()) == FIXTURE['tensor_bytes']
+    assert all(t.dtype == torch.bfloat16 for t in state.values())
+    inventory = '\n'.join(name + '|BF16|' + 'x'.join(map(str, value.shape))
+                          for name, value in sorted(state.items()))
+    assert hashlib.sha256(inventory.encode()).hexdigest() == FIXTURE['header_fingerprint']
+    assert MOSS_TTS_CHECKPOINTS[FIXTURE['repository']]['header_fingerprint'] == FIXTURE['header_fingerprint']
+
+
+def test_v15_inventory_and_revision_validation_remain_strict():
+    facts = _official_facts(FIXTURE['repository'], FIXTURE['revision'])
+    report = MossCheckpointReport(
+        path=Path('model.safetensors.index.json'), dtype_names=('BF16',),
+        **{key: FIXTURE[key] for key in ('tensor_count', 'parameter_count', 'tensor_bytes', 'header_fingerprint')},
+    )
+    _validate_official_report(report, facts)
+    for change in ({'tensor_count': report.tensor_count - 1},
+                   {'parameter_count': report.parameter_count + 1},
+                   {'tensor_bytes': report.tensor_bytes + 2},
+                   {'header_fingerprint': '0' * 64}):
+        with pytest.raises(CheckpointIntegrityError):
+            _validate_official_report(dataclasses.replace(report, **change), facts)
+    with pytest.raises(CheckpointIntegrityError):
+        _official_facts(FIXTURE['repository'], '0' * 40)
