 class NativeEchoRuntimeTests(unittest.TestCase):
 
+    def test_safetensors_casts_only_floating_weights(self):
+        import tempfile
+        from pathlib import Path
+        from voicehub.checkpointing import save_safetensors
+        from voicehub.models.echo.sampling import _load_safetensors
+
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'codec.safetensors'
+            source = {'weight': torch.randn(3, 4),
+                      'causal_mask': torch.ones(4, 4, dtype=torch.bool).tril(),
+                      'positions': torch.arange(4)}
+            save_safetensors(source, path)
+            actual = _load_safetensors(path, dtype=torch.bfloat16)
+            self.assertEqual(actual['weight'].dtype, torch.bfloat16)
+            self.assertEqual(actual['causal_mask'].dtype, torch.bool)
+            self.assertEqual(actual['positions'].dtype, torch.int64)
+            torch.testing.assert_close(actual['causal_mask'], source['causal_mask'])
+            torch.testing.assert_close(actual['positions'], source['positions'])
+
+    def test_released_codec_decoder_has_only_convolutional_weights(self):
+        from voicehub.models.echo.autoencoder import DecoderBlock
+
+        def unused_transformer(**kwargs):
+            raise AssertionError('Released Echo decoder has no transformer stage')
+        block = DecoderBlock(8, 4, stride=2, causal=True, n_t_layer=4,
+                             transformer_general_config=unused_transformer)
+        state = block.state_dict()
+        self.assertIn('block.0.alpha', state)
+        self.assertIn('block.1.conv.parametrizations.weight.original0', state)
+        self.assertFalse(any('attention' in name for name in state))
+        audio = block(torch.randn(1, 8, 4))
+        self.assertEqual(audio.shape, (1, 4, 8))
+        self.assertTrue(torch.isfinite(audio).all())
+
+    def test_codec_weight_norm_matches_pytorch_legacy_conversion(self):
+        from voicehub.models.echo.sampling import _canonicalize_codec_weight_norm
+        from torch.nn.utils import weight_norm as legacy_weight_norm
+        from torch.nn.utils.parametrizations import weight_norm
+
+        source = legacy_weight_norm(torch.nn.Conv1d(3, 4, 1)).eval()
+        target = weight_norm(torch.nn.Conv1d(3, 4, 1)).eval()
+        state = source.state_dict()
+        canonical = _canonicalize_codec_weight_norm(target, state)
+        _assign_validated_state(target, canonical)
+        signal = torch.randn(2, 3, 7)
+        torch.testing.assert_close(target(signal), source(signal))
+        with self.assertRaisesRegex(RuntimeError, 'Conflicting'):
+            _canonicalize_codec_weight_norm(target, {**state, **canonical})
+        incomplete = {name: tensor for name, tensor in state.items() if name != 'weight_v'}
+        with self.assertRaisesRegex(RuntimeError, 'Incomplete'):
+            _canonicalize_codec_weight_norm(target, incomplete)
+
